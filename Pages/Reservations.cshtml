@page
@model ReservationsModel
@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Reservations</h2>
    <table class="table table-dark table-striped reservations-table">
        <thead>
            <tr>
                <th>ID Reservation</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Room ID</th>
                <th>Organizer ID</th>
                <th>Room Request ID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservation in Model.Reservations)
            {
                <tr>
                    <td>@reservation.ID</td>
                    <td>@reservation.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@reservation.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@reservation.RoomID</td>
                    <td>@reservation.OrganizerID</td>
                    <td>@reservation.RoomRequestID</td>
                </tr>
            }
        </tbody>
    </table>
</div>
