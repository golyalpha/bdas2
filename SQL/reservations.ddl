CREATE OR REPLACE VIEW ORGANIZERS_V ( ID_ORGANIZER, name, email, waiting ) AS
SELECT DISTINCT
  o.ID_ORGANIZER,
  name,
  email,
  CASE WHEN EXISTS
    (
     SELECT * FROM room_requests r
      WHERE r.ID_ORGANIZER = o.ID_ORGANIZER
      AND r.ID_RESERVATION IS NULL
    )
    THEN 'Y'
    ELSE 'N'
  END AS waiting
FROM organizers o
     JOIN room_requests rr
     ON o.ID_ORGANIZER = rr.ID_ORGANIZER 
;

CREATE OR REPLACE VIEW ROOM_REQUESTS_V ( name, email, location, mincapacity, reservationstart, reservationend, reservationlength, vcready, podiumsize ) AS
SELECT
    organizers.name,
    organizers.email,
    locations.name AS location,
    ROOM_REQUESTS.mincapacity,
    ROOM_REQUESTS.reservationstart,
    ROOM_REQUESTS.reservationend,
    ROOM_REQUESTS.reservationlength,
    MEETING_RREQUESTS.vcready,
    PRESENTATION_RREQUESTS.podiumsize
FROM
    ROOM_REQUESTS
    INNER JOIN locations ON locations.id_location = ROOM_REQUESTS.id_location
    INNER JOIN organizers ON organizers.id_organizer = ROOM_REQUESTS.id_organizer,
    MEETING_RREQUESTS,
    PRESENTATION_RREQUESTS 
;

CREATE OR REPLACE VIEW ROOMS_V ( name, capacity, location, availabilitystart, availabilityend, vcready, podiumsize ) AS
SELECT
    rooms.name,
    rooms.capacity,
    locations.name AS "location",
    locations.availabilitystart,
    locations.availabilityend,
    MEETING_ROOMS.vcready,
    PRESENTATION_ROOMS.podiumsize
FROM
         rooms
    INNER JOIN locations ON locations.id_location = rooms.id_location,
    MEETING_ROOMS,
    PRESENTATION_ROOMS 
;

CREATE OR REPLACE VIEW USERS_V ( ID_ORGANIZER, email, credential_type, data, role ) AS
SELECT
	o.ID_ORGANIZER,
	o.email,
	c.credential_type,
	c.data,
	r.name role
FROM ORGANIZERS o 
     JOIN CREDENTIALS c ON o.ID_ORGANIZER = c.ID_ORGANIZER
	JOIN ROLES r ON o.ID_ROLE = r.ID_ROLE
GROUP BY c.credential_type 
;

