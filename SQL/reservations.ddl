    INSERT OR UPDATE OF id_room ON presentation_rooms
    FOR EACH ROW
DECLARE
    d VARCHAR2(17);
BEGIN
    SELECT
        a.type
    INTO d
    FROM
        rooms a
    WHERE
        a.id_room = :new.id_room;

