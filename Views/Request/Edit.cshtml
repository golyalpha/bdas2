@model WebApp.Models.RoomRequest

@{
    var isReadOnly = ViewBag.IsReadOnly ?? false;
    ViewData["Title"] = ViewBag.PageTitle ?? "Edit Request";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    
    @if (!isReadOnly)
    {
        <form id="editRequestForm" method="post" action="/Request/Edit/@Model.Id">
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label for="start">Začátek</label>
                <input type="datetime-local" id="start" name="Start" class="form-control" required 
                       value="@(Model.Start.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            
            <div class="form-group">
                <label for="end">Konec</label>
                <input type="datetime-local" id="end" name="End" class="form-control" required 
                       value="@(Model.End.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <!-- ZMĚNA: Read-only zobrazení délky -->
            <div class="form-group">
                <label for="length">Délka rezervace (automaticky vypočítaná)</label>
                <input type="text" id="length" class="form-control bg-light" readonly
                       value="@Model.GetFormattedLength()" />
                <small class="form-text text-muted">Délka se vypočítá automaticky při uložení</small>
            </div>

            <div class="form-group">
                <label for="minCapacity">Minimální kapacita</label>
                <input type="number" id="minCapacity" name="MinimumCapacity" class="form-control" 
                       value="@Model.MinimumCapacity" />
            </div>

            <div class="form-group">
                <label for="type">Typ místnosti</label>
                <input type="text" id="type" class="form-control" readonly 
                       value="@(Model.Type == "MEETING_RREQUEST" ? "Meeting Room" : "Presentation Room")" />
            </div>

            <div class="form-group">
                <label for="location">Lokace</label>
                <input type="text" id="location" class="form-control" readonly 
                       value="@Model.Location?.Name, @Model.Location?.City?.Name, @Model.Location?.City?.Country?.Name" />
            </div>

            @if (Model is WebApp.Models.MeetingRequest meetingRequest)
            {
                <div class="form-group">
                    <label for="vcReady">Video Call Ready</label>
                    <select id="vcReady" name="VideoCallReady" class="form-control">
                        <option value="true" selected="@meetingRequest.VideoCallReady">Yes</option>
                        <option value="false" selected="@(!meetingRequest.VideoCallReady)">No</option>
                    </select>
                </div>
            }

            @if (Model is WebApp.Models.PresentationRequest presentationRequest)
            {
                <div class="form-group">
                    <label for="podiumSize">Velikost pódia</label>
                    <input type="number" id="podiumSize" name="PodiumSize" class="form-control" 
                           value="@presentationRequest.PodiumSize" />
                </div>
            }

            <div class="form-group">
                <label for="organiserName">Organizátor</label>
                <input type="text" id="organiserName" class="form-control" readonly
                       value="@Model.Organiser.Name" />
            </div>
            
            <div class="form-group">
                <label for="organiserEmail">Email organizátora</label>
                <input type="email" id="organiserEmail" class="form-control" readonly 
                       value="@Model.Organiser.Email" />
            </div>
            
            <input type="hidden" id="id" name="Id" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Aktualizovat</button>
            <a href="/Request/Index" class="btn btn-secondary">Zpět na seznam</a>
        </form>
    }
    else
    {
        <!-- Read-only mode -->
        <div class="form-group">
            <label>Začátek</label>
            <input type="datetime-local" class="form-control" disabled 
                   value="@(Model.Start.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>
        
        <div class="form-group">
            <label>Konec</label>
            <input type="datetime-local" class="form-control" disabled 
                   value="@(Model.End.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <!-- ZMĚNA: Použití GetFormattedLength() -->
        <div class="form-group">
            <label>Délka rezervace</label>
            <input type="text" class="form-control" disabled 
                   value="@Model.GetFormattedLength()" />
        </div>

        <div class="form-group">
            <label>Minimální kapacita</label>
            <input type="number" class="form-control" disabled 
                   value="@Model.MinimumCapacity" />
        </div>

        <div class="form-group">
            <label>Typ místnosti</label>
            <input type="text" class="form-control" disabled 
                   value="@(Model.Type == "MEETING_RREQUEST" ? "Meeting Room" : "Presentation Room")" />
        </div>

        <div class="form-group">
            <label>Lokace</label>
            <input type="text" class="form-control" disabled 
                   value="@Model.Location?.Name, @Model.Location?.City?.Name, @Model.Location?.City?.Country?.Name" />
        </div>

        @if (Model is WebApp.Models.MeetingRequest meetingRequest)
        {
            <div class="form-group">
                <label>Video Call Ready</label>
                <input type="text" class="form-control" disabled 
                       value="@(meetingRequest.VideoCallReady ? "Yes" : "No")" />
            </div>
        }

        @if (Model is WebApp.Models.PresentationRequest presentationRequest)
        {
            <div class="form-group">
                <label>Velikost pódia</label>
                <input type="number" class="form-control" disabled 
                       value="@presentationRequest.PodiumSize" />
            </div>
        }

        <div class="form-group">
            <label>Organizátor</label>
            <input type="text" class="form-control" disabled
                   value="@Model.Organiser.Name" />
        </div>
        
        <div class="form-group">
            <label>Email organizátora</label>
            <input type="email" class="form-control" disabled 
                   value="@Model.Organiser.Email" />
        </div>

        <a href="/Request/Index" class="btn btn-secondary">Zpět na seznam žádostí</a>
        <a href="/Notification/Index" class="btn btn-info">Zpět na notifikace</a>
    }
</div>
