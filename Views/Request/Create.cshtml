@model WebApp.Models.RoomRequestViewModel

@{
    ViewData["Title"] = "Vytvořit žádost o rezervaci";
}

<div class="container mt-5">
    <h2>Vytvořit žádost o rezervaci</h2>
    
    @* Zobrazení chyb *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    
    <form id="createRequestForm" method="post" asp-controller="Request" asp-action="Create">
        @Html.AntiForgeryToken()
        
        <div class="form-group mb-3">
            <label asp-for="Request.Start" class="form-label">Začátek rezervace</label>
            <input type="datetime-local"
                   asp-for="Request.Start"
                   class="form-control"
                   required />
            <span asp-validation-for="Request.Start" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Request.End" class="form-label">Konec rezervace</label>
            <input type="datetime-local"
                   asp-for="Request.End"
                   class="form-control"
                   required />
            <small class="form-text text-muted">Konec musí být po začátku (IO5/SP5)</small>
            <span asp-validation-for="Request.End" class="text-danger"></span>
        </div>

        <!-- DÉLKA - READ-ONLY PREVIEW + HIDDEN INPUT -->
        <div class="form-group mb-3">
            <label class="form-label">
                Délka (vypočítaná automaticky)
                <i class="bi bi-calculator text-muted"></i>
            </label>
            <input type="text"
                   id="lengthDisplay"
                   class="form-control bg-light"
                   readonly
                   placeholder="Bude vypočítána po zadání začátku a konce" />
            <small class="form-text text-muted">
                Preview se zobrazí okamžitě, finální výpočet proběhne v databázi
            </small>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Request.MinimumCapacity" class="form-label">Minimální kapacita</label>
            <input type="number"
                   asp-for="Request.MinimumCapacity"
                   class="form-control"
                   min="1"
                   required />
            <span asp-validation-for="Request.MinimumCapacity" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Request.Type" class="form-label">Typ místnosti</label>
            <select asp-for="Request.Type" class="form-control" required>
                <option value="">-- Vyberte typ --</option>
                <option value="MEETING_RREQUEST">Meeting Room</option>
                <option value="PRESENTATION_RREQUEST">Presentation Room</option>
            </select>
            <span asp-validation-for="Request.Type" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="LocationId" class="form-label">Lokace</label>
            <select asp-for="LocationId" class="form-control" required>
                <option value="">-- Vyberte lokaci --</option>
                @foreach (var location in Model.Locations)
                {
                    <option value="@location.Id">
                        @location.Name, @location.City?.Name, @location.City?.Country?.Name
                    </option>
                }
            </select>
            <span asp-validation-for="LocationId" class="text-danger"></span>
        </div>

        <div id="meetingRequestFields" style="display: none;" class="mb-3">
            <div class="form-check">
                <input type="checkbox"
                       asp-for="MeetingRequest.VideoCallReady"
                       class="form-check-input" />
                <label asp-for="MeetingRequest.VideoCallReady" class="form-check-label">
                    Video Call Ready
                </label>
            </div>
        </div>

        <div id="presentationRequestFields" style="display: none;" class="mb-3">
            <div class="form-group">
                <label asp-for="PresentationRequest.PodiumSize" class="form-label">
                    Velikost pódia (m²)
                </label>
                <input type="number"
                       asp-for="PresentationRequest.PodiumSize"
                       class="form-control"
                       min="1" />
                <span asp-validation-for="PresentationRequest.PodiumSize" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Vytvořit žádost
            </button>
            <a asp-controller="Request" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Zpět
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const requestTypeSelect = document.getElementById("Request_Type");
            const meetingRequestFields = document.getElementById("meetingRequestFields");
            const presentationRequestFields = document.getElementById("presentationRequestFields");
            
            const startInput = document.getElementById("Request_Start");
            const endInput = document.getElementById("Request_End");
            const lengthDisplay = document.getElementById("lengthDisplay");
            const lengthHidden = document.getElementById("lengthHidden");

            function toggleFields() {
                const selectedType = requestTypeSelect.value;

                if (selectedType === "MEETING_RREQUEST") {
                    meetingRequestFields.style.display = "block";
                    presentationRequestFields.style.display = "none";
                } else if (selectedType === "PRESENTATION_RREQUEST") {
                    meetingRequestFields.style.display = "none";
                    presentationRequestFields.style.display = "block";
                } else {
                    meetingRequestFields.style.display = "none";
                    presentationRequestFields.style.display = "none";
                }
            }

            function calculateLengthInterval() {
                if (startInput.value && endInput.value) {
                    const start = new Date(startInput.value);
                    const end = new Date(endInput.value);
                    
                    if (end > start) {
                        const diffMs = end - start;
                        const totalHours = Math.floor(diffMs / (1000 * 60 * 60));
                        const totalMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                        
                        // 🔥 OPRAVA: Správný výpočet dnů, hodin, minut
                        const days = Math.floor(totalHours / 24);
                        const hours = totalHours % 24;
                        
                        let displayText = "✓ ";
                        if (days > 0) {
                            displayText += `${days}d `;
                        }
                        displayText += `${hours}h ${totalMinutes}min`;
                        
                        lengthDisplay.value = displayText;
                        lengthDisplay.classList.remove('is-invalid');
                        lengthDisplay.classList.add('is-valid');
                        
                        console.log(`Calculated: ${days} days, ${hours} hours, ${totalMinutes} minutes`);
                    } else {
                        lengthDisplay.value = "⚠️ Konec musí být po začátku!";
                        lengthDisplay.classList.add('is-invalid');
                        lengthDisplay.classList.remove('is-valid');
                        lengthHidden.value = "";
                    }
                } else {
                    lengthDisplay.value = "";
                    lengthDisplay.classList.remove('is-invalid', 'is-valid');
                    lengthHidden.value = "";
                }
            }

            toggleFields();
            requestTypeSelect.addEventListener("change", toggleFields);
            
            startInput.addEventListener("change", calculateLengthInterval);
            endInput.addEventListener("change", calculateLengthInterval);
            startInput.addEventListener("input", calculateLengthInterval);
            endInput.addEventListener("input", calculateLengthInterval);
            
            calculateLengthInterval();
        });
    </script>
    
    @* Client-side validation *@
    <partial name="_ValidationScriptsPartial" />
}
