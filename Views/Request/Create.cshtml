@model WebApp.Models.RoomRequestViewModel

@{
    ViewData["Title"] = "Create Request";
}

<div class="container mt-5">
    <h2>Create Request</h2>
    <form id="createRequestForm" method="post" action="/Request/Create">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            @Html.LabelFor(m => m.Request.Start, "Start Time", new { @class = "control-label" })
            <div>
                <input type="datetime-local"
                       name="@Html.NameFor(m => m.Request.Start)"
                       value="@(Model.Request?.Start.ToString("yyyy-MM-ddTHH:mm"))"
                       id="@Html.IdFor(m => m.Request.Start)"
                       class="form-control"
                       required />
                @Html.ValidationMessageFor(m => m.Request.Start, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Request.End, "End Time", new { @class = "control-label" })
            <div>
                <input type="datetime-local"
                       name="@Html.NameFor(m => m.Request.End)"
                       value="@(Model.Request?.End.ToString("yyyy-MM-ddTHH:mm"))"
                       id="@Html.IdFor(m => m.Request.End)"
                       class="form-control"
                       required />
                <small class="form-text text-muted">Konec musí být po začátku (IO5/SP5)</small>
                @Html.ValidationMessageFor(m => m.Request.End, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- DÉLKA - HIDDEN FIELD, VYPOČÍTANÁ V JAVASCRIPTU -->
        <div class="form-group">
            <label class="control-label">Délka (vypočítaná automaticky)</label>
            <div>
                <input type="text"
                       id="lengthDisplay"
                       class="form-control"
                       readonly
                       placeholder="Bude vypočítána automaticky" />
            </div>
        </div>
        
        <!-- HIDDEN: Skutečná hodnota délky pro odeslání -->
        <input type="hidden" 
               name="@Html.NameFor(m => m.Request.Length)" 
               id="@Html.IdFor(m => m.Request.Length)" />

        <div class="form-group">
            @Html.LabelFor(m => m.Request.MinimumCapacity)
            <div>
                <input type="number"
                       name="@Html.NameFor(m => m.Request.MinimumCapacity)"
                       value="@Html.ValueFor(m => m.Request.MinimumCapacity)"
                       id="@Html.IdFor(m => m.Request.MinimumCapacity)"
                       class="form-control"
                       required />
                @Html.ValidationMessageFor(m => m.Request.MinimumCapacity, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Request.Type)
            <select id="@Html.IdFor(m => m.Request.Type)" name="@Html.NameFor(m => m.Request.Type)" class="form-control" required>
                <option value="">-- Vyberte typ --</option>
                <option value="MEETING_RREQUEST" selected="@(Model.Request?.Type == "MEETING_RREQUEST")">Meeting Room</option>
                <option value="PRESENTATION_RREQUEST" selected="@(Model.Request?.Type == "PRESENTATION_RREQUEST")">Presentation Room</option>
            </select>
        </div>
        
        <div class="form-group">
            @Html.LabelFor(m => m.LocationId)
            <div>
                <select id="@Html.IdFor(m => m.LocationId)" name="@Html.NameFor(m => m.LocationId)" class="form-control" required>
                    @foreach (var location in Model.Locations)
                    {
                        @if (location.Id == Model.LocationId)
                        {
                            <option value="@location.Id.ToString()" selected>@location.Name, @location.City.Name, @location.City.Country.Name</option>
                        }
                        else
                        {
                            <option value="@location.Id.ToString()">@location.Name, @location.City.Name, @location.City.Country.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div id="meetingRequestFields" style="display: none;">
            <div class="form-group">
                @Html.LabelFor(m => m.MeetingRequest.VideoCallReady)
                @Html.CheckBoxFor(m => m.MeetingRequest.VideoCallReady)
                @Html.ValidationMessageFor(m => m.MeetingRequest.VideoCallReady, "", new { @class = "text-danger" })
            </div>
        </div>

        <div id="presentationRequestFields" style="display: none;">
            <div class="form-group">
                @Html.LabelFor(m => m.PresentationRequest.PodiumSize)
                <input type="number"
                       name="@Html.NameFor(m => m.PresentationRequest.PodiumSize)"
                       value="@Html.ValueFor(m => m.PresentationRequest.PodiumSize)"
                       id="@Html.IdFor(m => m.PresentationRequest.PodiumSize)"
                       class="form-control" />
                @Html.ValidationMessageFor(m => m.PresentationRequest.PodiumSize, "", new { @class = "text-danger" })
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>
    <div>
        <a href="/Request/Index" class="btn btn-link">Back to List</a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const requestTypeSelect = document.getElementById("Request_Type");
            const meetingRequestFields = document.getElementById("meetingRequestFields");
            const presentationRequestFields = document.getElementById("presentationRequestFields");
            
            // Elementy pro výpočet délky
            const startInput = document.getElementById("Request_Start");
            const endInput = document.getElementById("Request_End");
            const lengthHiddenInput = document.getElementById("Request_Length");  // Hidden field pro odeslání
            const lengthDisplay = document.getElementById("lengthDisplay");        // Readonly zobrazení

            function toggleFields() {
                const selectedType = requestTypeSelect.value;

                if (selectedType === "MEETING_RREQUEST") {
                    meetingRequestFields.style.display = "block";
                    presentationRequestFields.style.display = "none";
                } else if (selectedType === "PRESENTATION_RREQUEST") {
                    meetingRequestFields.style.display = "none";
                    presentationRequestFields.style.display = "block";
                } else {
                    meetingRequestFields.style.display = "none";
                    presentationRequestFields.style.display = "none";
                }
            }

            // Výpočet délky v reálném čase
            function calculateLength() {
                if (startInput.value && endInput.value) {
                    const start = new Date(startInput.value);
                    const end = new Date(endInput.value);
                    
                    if (end > start) {
                        const diffMs = end - start;
                        const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                        const diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                        
                        // Zobrazení pro uživatele
                        lengthDisplay.value = `${diffHours}h ${diffMinutes}min`;
                        lengthDisplay.classList.remove('text-danger');
                        
                        // Hodnota pro odeslání do DB (formát pro Oracle DATE: '1000-01-01 HH:MI')
                        const lengthFormatted = `1000-01-01 ${String(diffHours).padStart(2, '0')}:${String(diffMinutes).padStart(2, '0')}:00`;
                        lengthHiddenInput.value = lengthFormatted;
                        
                    } else {
                        lengthDisplay.value = "Konec musí být po začátku!";
                        lengthDisplay.classList.add('text-danger');
                        lengthHiddenInput.value = "";  // Nevyplníme, pokud je chyba
                    }
                } else {
                    lengthDisplay.value = "";
                    lengthHiddenInput.value = "";
                }
            }

            // Event listenery
            toggleFields();
            requestTypeSelect.addEventListener("change", toggleFields);
            startInput.addEventListener("change", calculateLength);
            endInput.addEventListener("change", calculateLength);
            
            // Inicializace při načtení stránky
            calculateLength();
        });
    </script>
}
