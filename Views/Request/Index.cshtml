@model IEnumerable<WebApp.Models.RoomRequest>

@{
    ViewData["Title"] = "Requests";
    var isAdmin = ViewBag.IsAdmin ?? false;
    var currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>

    <a asp-controller="Request" asp-action="Create" class="btn btn-primary">Create New Request</a>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Length</th>
                <th>Organizer</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                var canEdit = isAdmin || request.Organiser.Id == currentUserId;
                <tr>
                    <td>@request.Start.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@request.End.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@request.Length.ToString("H:mm")</td>
                    <td>@request.Organiser.Name</td>
                    <td>@request.Type</td>
                    <td>
                        @if (canEdit)
                        {
                            <a href="/Request/Edit?id=@request.Id" class="btn btn-warning btn-sm">Edit</a>
                            <form asp-action="Delete" asp-controller="Request" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@request.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this request?');">
                                    Delete
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
