@model IEnumerable<WebApp.Models.Room>

@{
    ViewData["Title"] = "Místnosti";
    var isGuest = ViewBag.IsGuest ?? false;
    var isAdmin = ViewBag.IsAdmin ?? false;
    var currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        @if (!isGuest)
        {
            <a asp-controller="Room" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Přidat novou místnost
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Název</th>
                <th>Kapacita</th>
                <th>Typ</th>
                <th>Lokace</th>
                <th>Vlastník</th>
                <th class="text-center">Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                var canEdit = (isAdmin || room.Organiser.Id == currentUserId) && !isGuest;
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity</td>
                    <td>
                        @if (room.Type == "MEETING_ROOM")
                        {
                            <span class="badge bg-primary">Jednací místnost</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Prezentacní místnost</span>
                        }
                    </td>
                    <td>@room.Location.Name</td>
                    <td>
                        @if (isAdmin)
                        {
                            <span class="badge bg-secondary">@room.Organiser.Name</span>
                        }
                        else
                        {
                            <text>@room.Organiser.Name</text>
                        }
                    </td>
                    <td class="text-center">
                        @if (canEdit)
                        {
                            <a href="/Room/Edit?id=@room.Id" class="btn btn-warning btn-sm" title="Upravit">
                                <i class="bi bi-pencil"></i> Upravit
                            </a>
                            <form asp-action="Delete" asp-controller="Room" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@room.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" 
                                        onclick="return confirm('Opravdu chcete smazat tuto místnost?');">
                                    <i class="bi bi-trash"></i> Smazat
                                </button>
                            </form>
                        }
                        else if (isGuest)
                        {
                            <span class="text-muted" title="Jako Guest můžete pouze prohlížet">Pouze čtení</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
