@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Rooms</h2>
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Capacity</th>
                <th>Type</th>
                <th>Location name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity</td>
                    <td>@room.Type</td>
                    <td>@room.Location.Name</td>
                </tr>
            }
        </tbody>
    </table>
</div>
