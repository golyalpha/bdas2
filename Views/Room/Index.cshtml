@model IEnumerable<WebApp.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <a asp-controller="Room" asp-action="Create" class="btn btn-primary">Add New Room</a>


    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Capacity</th>
                <th>Type</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity</td>
                    <td>@room.Type</td>
                    <td>@room.Location?.Name</td>
                    <td>
                        <a href="/Room/Edit/@room.Id" class="btn btn-warning">Edit</a>

                        <form asp-action="Delete" asp-controller="Room" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@room.Id" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this room?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>  
            }
        </tbody>
    </table>
</div>
