@model IEnumerable<WebApp.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-5">
    <h2>Rooms List</h2>
    <a href="/Room/Create" class="btn btn-primary mb-3">Add New Room</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Capacity</th>
                <th>Type</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity</td>
                    <td>@room.Type</td>
                    <td>@room.Location?.Name</td>
                    <td>
                        <a href="/Room/Edit/@room.Id" class="btn btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
