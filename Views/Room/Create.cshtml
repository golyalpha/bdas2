@model WebApp.Models.Room

@{
    ViewData["Title"] = "Create Room";
}

<div class="container mt-5">
    <h2>Create Room</h2>
    <form id="createRoomForm" method="post" action="/Room/Create">
        <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="capacity">Capacity</label>
            <input type="number" id="capacity" name="Capacity" class="form-control" required min="1" />
        </div>
        <div class="form-group">
            <label for="Type" class="control-label">Room Type</label>
            <select asp-for="Type" class="form-control" id="roomTypeSelect">
                <option value="MEETING_ROOM">Meeting Room</option>
                <option value="PRESENTATION_ROOM">Presentation Room</option>
            </select>
        </div>


        <div id="meetingRoomFields">
            <div class="form-group">
                <label for="vcReady" class="control-label">Video Call Ready</label>
                <select name="vcReady" class="form-control">
                    <option value="Y">Yes</option>
                    <option value="N">No</option>
                </select>
            </div>
        </div>

        <div id="presentationRoomFields" style="display:none;">
            <div class="form-group">
                <label for="podiumSize" class="control-label">Podium Size</label>
                <input name="podiumSize" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="Location.Id" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="location">Organiser</label>
            <input type="text" id="location" name="Organiser.Id" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
    <div>
        <a href="/Room/Index" class="btn btn-link">Back to List</a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const roomTypeSelect = document.getElementById("roomTypeSelect");
            const meetingRoomFields = document.getElementById("meetingRoomFields");
            const presentationRoomFields = document.getElementById("presentationRoomFields");

            function toggleFields() {
                const selectedType = roomTypeSelect.value;

                if (selectedType === "MEETING_ROOM") {
                    meetingRoomFields.style.display = "block";
                    presentationRoomFields.style.display = "none";
                } else if (selectedType === "PRESENTATION_ROOM") {
                    meetingRoomFields.style.display = "none";
                    presentationRoomFields.style.display = "block";
                }
            }

            // Přepnutí na základě výchozí hodnoty
            toggleFields();

            // Přepnutí při změně hodnoty comboboxu
            roomTypeSelect.addEventListener("change", toggleFields);
        }); 
    </script>
}
