@model WebApp.Models.Room

@{
    ViewData["Title"] = "Create Room";
}

<div class="container mt-5">
    <h2>Create Room</h2>
    <form id="createRoomForm" method="post" action="/Room/Create">
        <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="capacity">Capacity</label>
            <input type="number" id="capacity" name="Capacity" class="form-control" required min="1" />
        </div>
        <div class="form-group">
            <label for="type">Type</label>
            <input type="text" id="type" name="Type" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="Location.Name" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
    <div>
        <a href="/Room/Index" class="btn btn-link">Back to List</a>
    </div>
</div>
