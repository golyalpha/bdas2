@model WebApp.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<div class="container mt-5">
    <h2>Edit Room</h2>
    <form id="editRoomForm" method="post" action="/Room/Update">
        <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="Name" class="form-control" required value="@Model.Name" />
        </div>
        <div class="form-group">
            <label for="capacity">Capacity</label>
            <input type="number" id="capacity" name="Capacity" class="form-control" required value="@Model.Capacity" min="1" />
        </div>
        <div class="form-group">
            <label for="type">Type</label>
            <input type="text" id="type" name="Type" class="form-control" required value="@Model.Type" />
        </div>
        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="Location.Id" class="form-control" required value="@Model.Location.Id" />
        </div>
        <input type="hidden" id="id" name="Id" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
    <div>
        <a href="/Room/Index" class="btn btn-link">Back to List</a>
    </div>
</div>
