@{
    ViewData["Title"] = "Locations";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Locations</h2>

    <p>
        <a asp-controller="Location" asp-action="Create" class="btn btn-primary">Create New Location</a>
    </p>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Availability Start</th>
                <th>Availability End</th>
                <th>City</th>
                <th>Country</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                <tr>
                    <td>@location.Name</td>
                    <td>@location.AvailabilityStart.ToString("HH:mm")</td>
                    <td>@location.AvailabilityEnd.ToString("HH:mm")</td>
                    <td>@location.City.Name</td>
                    <td>@location.City.Country.Name</td>
                </tr>
            }
        </tbody>
    </table>
</div>
