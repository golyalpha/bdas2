@model IEnumerable<WebApp.Models.Location>

@{
    ViewData["Title"] = "Budovy";
    var isAdmin = ViewBag.IsAdmin ?? false;
    var isManager = ViewBag.IsManager ?? false;
    var currentUserId = ViewBag.CurrentUserId ?? 0;
    var canCreateLocation = isAdmin || isManager;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        @if (canCreateLocation)
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Přidat budovu
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Název</th>
                <th>Město</th>
                <th>Dostupnost od</th>
                <th>Dostupnost do</th>
                <th>Vlastník</th>
                <th class="text-center">Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                var canEdit = isAdmin || (isManager && location.Organiser.Id == currentUserId);
                
                <tr>
                    <td>@location.Name</td>
                    <td>@location.City.Name</td>
                    <td>@location.AvailabilityStart.ToString("HH:mm")</td>
                    <td>@location.AvailabilityEnd.ToString("HH:mm")</td>
                    <td>
                        @location.Organiser.Name
                        @if (location.Organiser.Id == currentUserId)
                        {
                            <span class="badge bg-primary ms-2">Vaše</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            @if (canEdit)
                            {
                                <a href="@Url.Action("Edit", new { id = location.Id })" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Upravit
                                </a>
                                <form asp-action="Delete" asp-route-id="@location.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Opravdu chcete smazat tuto budovu?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Smazat
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Nelze upravovat</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
