@model IEnumerable<WebApp.Models.Location>


@{
    ViewData["Title"] = "Locations";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <a asp-controller="Location" asp-action="Create" class="btn btn-primary">Add new Location</a>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Availability Start</th>
                <th>Availability End</th>
                <th>City</th>
                <th>Country</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                <tr>
                    <td>@location.Name</td>
                    <td>@location.AvailabilityStart.ToString("HH:mm")</td>
                    <td>@location.AvailabilityEnd.ToString("HH:mm")</td>
                    <td>@location.City.Name</td>
                    <td>@location.City.Country.Name</td>
                    <td>
                        <a href="/Location/Edit?id=@location.Id" class="btn btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
