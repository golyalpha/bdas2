@{
    ViewData["Title"] = "Locations";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <a asp-controller="Location" asp-action="Create" class="btn btn-primary">Add new Location</a>
    
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Availability Start</th>
                <th>Availability end</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                <tr>
                    <td>@location.Name</td>
                    <td>@location.AvailabilityStart.ToString("HH:mm")</td>
                    <td>@location.AvailabilityEnd.ToString("HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
