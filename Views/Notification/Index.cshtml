@model IEnumerable<WebApp.Models.Notification>

@{
    ViewData["Title"] = "Notifikace";
}

<div class="container mt-5">
    <h2><i class="bi bi-bell"></i> @ViewData["Title"]</h2>

    @if (Model != null && Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 
            Celkem <strong>@Model.Count()</strong> notifikací, 
            z toho <strong>@Model.Count(n => !n.Delivered)</strong> nových
        </div>

        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Typ notifikace</th>
                    <th>Požadavek</th>
                    <th>Místo</th>
                    <th>Datum zaèátku</th>
                    <th>Stav</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var notification in Model)
                {
                    <tr class="@(notification.Delivered ? "" : "table-primary")">
                        <td>
                            <strong>@notification.NotificationType.Name</strong>
                            @if (!string.IsNullOrEmpty(notification.NotificationType.Description))
                            {
                                <i class="bi bi-info-circle text-info ms-2" 
                                   data-bs-toggle="tooltip" 
                                   data-bs-placement="top" 
                                   title="@notification.NotificationType.Description"></i>
                            }
                            <br />
                            <small class="text-muted">(@notification.NotificationType.Code)</small>
                        </td>
                        <td>@notification.Request.Type</td>
                        <td>@notification.Request.Location?.Name</td>
                        <td>@notification.Request.Start.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (notification.Delivered)
                            {
                                <span class="badge bg-secondary"><i class="bi bi-check-circle"></i> Pøeèteno</span>
                            }
                            else
                            {
                                <span class="badge bg-primary"><i class="bi bi-bell-fill"></i> Nová</span>
                            }
                        </td>
                        <td>
                            <a href="/Request/Detail/@notification.Request.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-eye"></i> Detail
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle fs-3"></i>
            <p class="mt-2 mb-0">Nemáte žádné notifikace.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Inicializace Bootstrap tooltipù
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}