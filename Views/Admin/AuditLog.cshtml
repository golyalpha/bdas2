@model List<WebApp.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    var selectedTable = ViewBag.SelectedTable as string;
}

<div class="container mt-4">
    <h2 class="text-light mb-4">
        <i class="bi bi-clipboard-data"></i> Audit Log - Historie zmìn
    </h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtr podle tabulky -->
    <div class="card bg-dark text-light mb-3">
        <div class="card-body">
            <form method="get" asp-action="AuditLog" class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Filtrovat podle tabulky:</label>
                    <select name="tableName" class="form-select bg-dark text-light">
                        <option value="">-- Všechny tabulky --</option>
                        <option value="RESERVATIONS" selected="@(selectedTable == "RESERVATIONS")">RESERVATIONS</option>
                        <option value="ROOMS" selected="@(selectedTable == "ROOMS")">ROOMS</option>
                        <option value="LOCATIONS" selected="@(selectedTable == "LOCATIONS")">LOCATIONS</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-funnel"></i> Filtrovat
                    </button>
                    <a asp-action="AuditLog" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabulka audit logu -->
    <div class="card bg-dark text-light">
        <div class="card-body">
            <table class="table table-dark table-striped table-sm">
                <thead>
                    <tr>
                        <th style="width: 150px;">Èas</th>
                        <th>Tabulka</th>
                        <th>Operace</th>
                        <th>ID záznamu</th>
                        <th>Uživatel</th>
                        <th>Staré hodnoty</th>
                        <th>Nové hodnoty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-muted small">@log.ChangedAt</td>
                            <td><span class="badge bg-info">@log.TableName</span></td>
                            <td>
                                @if (log.Operation == "INSERT")
                                {
                                    <span class="badge bg-success">@log.Operation</span>
                                }
                                else if (log.Operation == "UPDATE")
                                {
                                    <span class="badge bg-warning text-dark">@log.Operation</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@log.Operation</span>
                                }
                            </td>
                            <td><code>@log.RecordId</code></td>
                            <td>@log.OrganizerName</td>
                            <td class="text-muted small">@log.OldValues</td>
                            <td class="text-success small">@log.NewValues</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Žádné záznamy v audit logu.
                </div>
            }
            else
            {
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i> Zobrazeno posledních <strong>@Model.Count</strong> záznamù
                    </small>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="DatabaseObjects" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Zpìt na DB objekty
        </a>
    </div>
</div>