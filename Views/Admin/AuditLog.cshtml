@model PagedResult<AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}

<h2>Audit Log</h2>

<!-- Filtry -->
<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Tabulka</label>
            <input type="text" name="tableName" class="form-control" value="@(ViewBag.TableName ?? "")" placeholder="Název tabulky" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Operace</label>
            <select name="operation" class="form-select">
                <option value="">Vše</option>
                <option value="INSERT" selected="@(ViewBag.Operation == "INSERT")">INSERT</option>
                <option value="UPDATE" selected="@(ViewBag.Operation == "UPDATE")">UPDATE</option>
                <option value="DELETE" selected="@(ViewBag.Operation == "DELETE")">DELETE</option>
            </select>
        </div>
        
        <div class="col-md-3">
            <label class="form-label">Od data</label>
            <input type="datetime-local" name="dateFrom" class="form-control" 
                   value="@(ViewBag.DateFrom != null ? ((DateTime)ViewBag.DateFrom).ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>
        
        <div class="col-md-3">
            <label class="form-label">Do data</label>
            <input type="datetime-local" name="dateTo" class="form-control" 
                   value="@(ViewBag.DateTo != null ? ((DateTime)ViewBag.DateTo).ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>
        
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </div>
</form>

<!-- Tabulka -->
<div class="table-responsive">
    <table class="table table-striped table-hover table-dark">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tabulka</th>
                <th>Operace</th>
                <th>Record ID</th>
                <th>Organizátor</th>
                <th>Změny</th>
                <th>Staré hodnoty</th>
                <th>Nové hodnoty</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Items == null || !Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-2">Žádné záznamy nenalezeny</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td>@log.IdLog</td>
                        <td><span class="badge bg-secondary">@log.TableName</span></td>
                        <td>
                            @if (log.Operation == "INSERT")
                            {
                                <span class="badge bg-success">INSERT</span>
                            }
                            else if (log.Operation == "UPDATE")
                            {
                                <span class="badge bg-warning text-dark">UPDATE</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">DELETE</span>
                            }
                        </td>
                        <td>@(log.RecordId?.ToString() ?? "-")</td>
                        <td>@(log.OrganizerName ?? "-")</td>
                        <td>@log.ChangedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td><small class="text-muted">@(log.OldValues ?? "-")</small></td>
                        <td><small>@(log.NewValues ?? "-")</small></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Stránkování -->
@if (Model?.TotalPages > 1)
{
    var pageSize = ViewBag.PageSize ?? 50;
    var tableName = ViewBag.TableName ?? "";
    var operation = ViewBag.Operation ?? "";
    var dateFrom = ViewBag.DateFrom != null ? ((DateTime)ViewBag.DateFrom).ToString("yyyy-MM-ddTHH:mm") : "";
    var dateTo = ViewBag.DateTo != null ? ((DateTime)ViewBag.DateTo).ToString("yyyy-MM-ddTHH:mm") : "";
    
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PageNumber - 1)&pageSize=@pageSize&tableName=@tableName&operation=@operation&dateFrom=@dateFrom&dateTo=@dateTo">Předchozí</a>
            </li>
            
            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i&pageSize=@pageSize&tableName=@tableName&operation=@operation&dateFrom=@dateFrom&dateTo=@dateTo">@i</a>
                </li>
            }
            
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PageNumber + 1)&pageSize=@pageSize&tableName=@tableName&operation=@operation&dateFrom=@dateFrom&dateTo=@dateTo">Další</a>
            </li>
        </ul>
    </nav>
    
    <p class="text-center text-muted">
        Stránka @Model.PageNumber z @Model.TotalPages (celkem @Model.TotalCount záznamů)
    </p>
}