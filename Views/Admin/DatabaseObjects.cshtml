@model List<WebApp.Models.DatabaseObject>
@{
    ViewData["Title"] = "Databázové objekty";
}

<div class="container mt-4">
    <h2 class="text-light mb-4">
        <i class="bi bi-database"></i> Databázové objekty
    </h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistiky - Klikatelné kartičky -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-light db-object-filter-card" onclick="filterByType('TABLE')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "TABLE")</h3>
                    <p class="mb-0"><i class="bi bi-table"></i> Tabulky</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-light db-object-filter-card" onclick="filterByType('VIEW')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "VIEW")</h3>
                    <p class="mb-0"><i class="bi bi-eye"></i> Pohledy</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark db-object-filter-card" onclick="filterByType('PROCEDURE')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "PROCEDURE")</h3>
                    <p class="mb-0"><i class="bi bi-gear"></i> Procedury</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-dark db-object-filter-card" onclick="filterByType('FUNCTION')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "FUNCTION")</h3>
                    <p class="mb-0"><i class="bi bi-code-square"></i> Funkce</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-light db-object-filter-card" onclick="filterByType('PACKAGE')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "PACKAGE")</h3>
                    <p class="mb-0"><i class="bi bi-box"></i> Balíčky</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-light db-object-filter-card" onclick="filterByType('TRIGGER')">
                <div class="card-body text-center">
                    <h3>@Model.Count(o => o.Type == "TRIGGER")</h3>
                    <p class="mb-0"><i class="bi bi-lightning"></i> Triggery</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabulka objektů -->
    <div class="card bg-dark text-light">
        <div class="card-body">
            <div class="mb-3">
                <input type="text" id="searchBox" class="form-control bg-dark text-light" 
                       placeholder="🔍 Vyhledat objekt (název nebo typ)...">
            </div>

            <table class="table table-dark table-striped table-hover" id="objectsTable">
                <thead>
                    <tr>
                        <th>Typ</th>
                        <th>Název</th>
                        <th>Status</th>
                        <th>Vytvořeno</th>
                        <th>Naposledy upraveno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var obj in Model.OrderBy(o => o.Type).ThenBy(o => o.Name))
                    {
                        <tr>
                            <td>
                                @if (obj.Type == "TABLE")
                                {
                                    <span class="badge bg-primary">@obj.Type</span>
                                }
                                else if (obj.Type == "VIEW")
                                {
                                    <span class="badge bg-success">@obj.Type</span>
                                }
                                else if (obj.Type == "PROCEDURE")
                                {
                                    <span class="badge bg-warning text-dark">@obj.Type</span>
                                }
                                else if (obj.Type == "FUNCTION")
                                {
                                    <span class="badge bg-info text-dark">@obj.Type</span>
                                }
                                else if (obj.Type == "PACKAGE")
                                {
                                    <span class="badge bg-secondary">@obj.Type</span>
                                }
                                else if (obj.Type == "TRIGGER")
                                {
                                    <span class="badge bg-danger">@obj.Type</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">@obj.Type</span>
                                }
                            </td>
                            <td><code class="text-info">@obj.Name</code></td>
                            <td>
                                @if (obj.Status == "VALID")
                                {
                                    <span class="text-success"><i class="bi bi-check-circle"></i> @obj.Status</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle"></i> @obj.Status</span>
                                }
                            </td>
                            <td class="text-muted small">@obj.CreatedDate</td>
                            <td class="text-muted small">@obj.LastModified</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Žádné databázové objekty nenalezeny.
                </div>
            }
            else
            {
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-collection"></i> Celkem objektů: <strong>@Model.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Hierarchy" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Zpět na hierarchii
        </a>
    </div>
</div>

@section Scripts {
<script>
    // Funkce pro nastavení filtru - jednoduše vyplní search box
    function filterByType(type) {
        const searchBox = document.getElementById('searchBox');
        searchBox.value = type;
        // Trigger keyup event pro spuštění existující vyhledávací logiky
        searchBox.dispatchEvent(new Event('keyup'));
    }

    // Vyhledávání v tabulce
    document.getElementById('searchBox').addEventListener('keyup', function() {
        const filter = this.value.toUpperCase();
        const rows = document.querySelectorAll('#objectsTable tbody tr');
        
        rows.forEach(function(row) {
            const text = row.textContent.toUpperCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>
}