@model List<WebApp.Models.OrganizerHierarchy>
@{
    ViewData["Title"] = "Hierarchie organizátorù";
}

<div class="container mt-4">
    <h2 class="text-light mb-4">
        <i class="bi bi-diagram-3"></i> Hierarchie organizátorù
    </h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card bg-dark text-light">
        <div class="card-body">
            <p class="text-muted mb-3">
                <i class="bi bi-info-circle"></i>
                Hierarchická struktura organizátorù podle zastupování.
            </p>

            <table class="table table-dark table-striped table-hover">
                <thead>
                    <tr>
                        <th style="width: 80px;">Úroveò</th>
                        <th>Jméno</th>
                        <th>Email</th>
                        <th>Hierarchická cesta</th>
                        <th>Hlavní organizátor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var org in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge bg-primary">@org.Level</span>
                            </td>
                            <td style="padding-left: @((org.Level - 1) * 20)px;">
                                @if (org.Level > 1)
                                {
                                    <i class="bi bi-arrow-return-right text-muted"></i>
                                }
                                <strong>@org.Name</strong>
                            </td>
                            <td>
                                <small class="text-muted">@org.Email</small>
                            </td>
                            <td>
                                <code class="text-info">@org.HierarchyPath</code>
                            </td>
                            <td>
                                <span class="badge bg-success">@org.TopOrganizer</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Žádná hierarchie nenalezena.
                </div>
            }
            else
            {
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-graph-up"></i> Celkem organizátorù: <strong>@Model.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Zpìt na seznam uživatelù
        </a>
    </div>
</div>