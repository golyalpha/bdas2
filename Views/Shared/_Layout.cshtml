<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-dark text-light">
    @Html.AntiForgeryToken()
    
    <!-- IMPERSONATION BANNER - zobrazit vždy když je aktivní impersonace -->
    @if (User.Identity?.IsAuthenticated == true && User.HasClaim("IsImpersonating", "true"))
    {
        <div class="alert alert-warning mb-0 text-center rounded-0" role="alert" style="position: sticky; top: 0; z-index: 1030;">
            <strong>⚠️ REŽIM IMPERSONACE ⚠️</strong>
            Jednáte jako uživatel <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</strong>
            (Původní admin: @User.FindFirst("OriginalUserName")?.Value)
            <form asp-controller="User" asp-action="StopImpersonation" method="post" class="d-inline ms-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger">
                    <i class="bi bi-x-circle"></i> Ukončit impersonaci
                </button>
            </form>
        </div>
    }
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Request" asp-action="Index">Žádosti o rezervace</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Reservation" asp-action="Index">Rezervace</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Room" asp-action="Index">Místnosti</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Location" asp-action="Index">Budovy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="User" asp-action="Index">Uživatelé</a>
                        </li>

                        @* ADMIN MENU - zobrazit pokud je uživatel admin NEBO pokud impersonuje a původně byl admin *@
                        @{
                            var isAdmin = User.IsInRole("Administrator");
                            var isImpersonatingAsAdmin = User.HasClaim("OriginalUserRole", "Administrator");
                            var showAdminMenu = isAdmin || isImpersonatingAsAdmin;
                        }

                        @if (showAdminMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock"></i> Administrace
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Hierarchy">
                                            <i class="bi bi-diagram-3"></i> Hierarchie organizátorů
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="DatabaseObjects">
                                            <i class="bi bi-database"></i> DB Objekty
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="AuditLog">
                                            <i class="bi bi-clipboard-data"></i> Audit Log
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    @* Zobrazit tlačítko pro impersonaci pouze pokud NENÍ aktivní impersonace *@
                                    @if (!User.HasClaim("IsImpersonating", "true"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="User" asp-action="Impersonate">
                                                <i class="bi bi-person-fill-gear"></i> Impersonovat uživatele
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    
                    <div class="ms-auto d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Notification Bell -->
                            <div class="dropdown me-3">
                                <button class="btn btn-link text-light position-relative" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell" style="font-size: 1.5rem;"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown" style="min-width: 350px; max-height: 400px; overflow-y: auto;">
                                    <li class="dropdown-header">Notifikace</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <div id="notificationList">
                                        <li class="dropdown-item text-center text-muted">Načítání...</li>
                                    </div>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="text-center">
                                        <a class="dropdown-item" href="/Notification/Index">Zobrazit všechny</a>
                                    </li>
                                </ul>
                            </div>

                            <span class="me-3">
                                Vítejte, @User.Identity.Name!
                                @if (User.HasClaim("IsImpersonating", "true"))
                                {
                                    <span class="badge bg-warning text-dark ms-2">
                                        <i class="bi bi-person-fill-gear"></i> Impersonace
                                    </span>
                                }
                            </span>
                            <form asp-controller="User" asp-action="Logout" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-primary" type="submit">Odhlásit se</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary me-2" asp-area="" asp-controller="User" asp-action="Login">Přihlásit se</a>
                            <a class="btn btn-primary" asp-area="" asp-controller="User" asp-action="Register">Registrovat</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
