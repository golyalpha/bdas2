@model WebApp.Models.Reservation

@{
    ViewData["Title"] = Model.Id > 0 ? "Upravit rezervaci" : "Vytvořit rezervaci";
    bool isEditMode = Model.Id > 0;
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    
    @* Zobrazení chyb *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    
    <form id="reservationForm" method="post" asp-action="Persist" asp-controller="Reservation">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Start" class="form-label">Začátek rezervace</label>
            <input type="datetime-local" 
                   asp-for="Start" 
                   class="form-control" 
                   required />
            <span asp-validation-for="Start" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="End" class="form-label">Konec rezervace</label>
            <input type="datetime-local" 
                   asp-for="End" 
                   class="form-control" 
                   required />
            <small class="form-text text-muted">Konec musí být po začátku (SP5)</small>
            <span asp-validation-for="End" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Room.Id" class="form-label">Místnost</label>
            <select asp-for="Room.Id" class="form-control" required>
                <option value="">-- Vyberte místnost --</option>
                @foreach (var room in ViewBag.Rooms as List<WebApp.Models.Room>)
                {
                    <option value="@room.Id" selected="@(room.Id == Model.Room?.Id)">
                        @room.Name (Kapacita: @room.Capacity)
                    </option>
                }
            </select>
            <span asp-validation-for="Room.Id" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Request.Id" class="form-label">Žádost o rezervaci</label>
            <select asp-for="Request.Id" class="form-control" required disabled="@isEditMode">
                <option value="">-- Vyberte žádost --</option>
                @foreach (var request in ViewBag.Requests as List<WebApp.Models.RoomRequest>)
                {
                    <option value="@request.Id" selected="@(request.Id == Model.Request?.Id)">
                        Request #@request.Id - @request.Start.ToString("dd.MM.yyyy HH:mm")
                    </option>
                }
            </select>
            @if (isEditMode)
            {
                <input type="hidden" asp-for="Request.Id" value="@Model.Request.Id" />
                <small class="form-text text-muted">⚠️ Nelze změnit žádost u existující rezervace</small>
            }
            <span asp-validation-for="Request.Id" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Organiser.Id" class="form-label">Organizátor</label>
            <select asp-for="Organiser.Id" class="form-control" required disabled>
                @foreach (var organiser in ViewBag.Organisers as List<WebApp.Models.Organiser>)
                {
                    <option value="@organiser.Id" selected="@(organiser.Id == Model.Organiser?.Id)">
                        @organiser.Name (@organiser.Email)
                    </option>
                }
            </select>
            <input type="hidden" asp-for="Organiser.Id" value="@Model.Organiser.Id" />
            <small class="form-text text-muted">ℹ️ Organizátor je přiřazen automaticky</small>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> @(isEditMode ? "Uložit změny" : "Vytvořit rezervaci")
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Zpět
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.getElementById("Start");
            const endInput = document.getElementById("End");

            // SP5: Validace Start < End
            function validateDates() {
                if (startInput.value && endInput.value) {
                    const start = new Date(startInput.value);
                    const end = new Date(endInput.value);
                    
                    if (end <= start) {
                        endInput.setCustomValidity("Konec musí být po začátku (SP5)");
                        endInput.classList.add('is-invalid');
                    } else {
                        endInput.setCustomValidity("");
                        endInput.classList.remove('is-invalid');
                        endInput.classList.add('is-valid');
                    }
                } else {
                    endInput.setCustomValidity("");
                    endInput.classList.remove('is-invalid', 'is-valid');
                }
            }

            startInput.addEventListener("change", validateDates);
            endInput.addEventListener("change", validateDates);
            startInput.addEventListener("input", validateDates);
            endInput.addEventListener("input", validateDates);
            
            validateDates(); // Initial check
        });
    </script>
    
    <partial name="_ValidationScriptsPartial" />
}
