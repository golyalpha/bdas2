@model IEnumerable<WebApp.Models.Reservation>

@{
    ViewData["Title"] = "Reservations List";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>

    <a asp-controller="Reservation" asp-action="Create" class="btn btn-primary">Add New Reservation</a>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Room</th>
                <th>Organiser</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservation in Model)
            {
                <tr>
                    <td>@reservation.Start.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@reservation.End.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@reservation.Room?.Name</td>
                    <td>@reservation.Organiser?.Name (@reservation.Organiser?.Email)</td>
                    <td>
                        <a href="/Reservation/Edit/@reservation.Id" class="btn btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
