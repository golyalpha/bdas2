@model WebApp.Models.Organiser

@{
    ViewData["Title"] = $"Změnit roli - {Model.Name}";
    var roles = ViewBag.Roles as List<WebApp.Models.Role>;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark text-light">
                <div class="card-header">
                    <h4>Změnit roli uživatele @Model.Name</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="EditRole" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Uživatel:</label>
                            <input type="text" class="form-control" 
                                   value="@Model.Name (@Model.Email)" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Aktuální role:</label>
                            <div>
                                @if (Model.Role.Name == "Administrator")
                                {
                                    <span class="badge bg-danger fs-6">Administrator</span>
                                }
                                else if (Model.Role.Name == "User")
                                {
                                    <span class="badge bg-primary fs-6">User</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">Guest</span>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="roleId" class="form-label">Nová role:</label>
                            <select id="roleId" name="roleId" class="form-select" required>
                                @foreach (var role in roles)
                                {
                                    var isSelected = role.Id == Model.Role.Id;
                                    <option value="@role.Id" selected="@isSelected">
                                        @role.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <h5>Přehled oprávnění:</h5>
                            <table class="table table-sm table-dark table-bordered">
                                <thead>
                                    <tr>
                                        <th>Akce</th>
                                        <th class="text-center">Admin</th>
                                        <th class="text-center">User</th>
                                        <th class="text-center">Guest</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Spravovat všechny záznamy</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-danger">✗</td>
                                        <td class="text-center text-danger">✗</td>
                                    </tr>
                                    <tr>
                                        <td>Vytvářet/editovat vlastní záznamy</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-danger">✗</td>
                                    </tr>
                                    <tr>
                                        <td>Prohlížet místnosti a lokace</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-success">✓</td>
                                    </tr>
                                    <tr>
                                        <td>Měnit role a náhradníky</td>
                                        <td class="text-center text-success">✓</td>
                                        <td class="text-center text-danger">✗</td>
                                        <td class="text-center text-danger">✗</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                Uložit změnu
                            </button>
                            <a href="/User/Index" class="btn btn-secondary">
                                Zpět na seznam
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>