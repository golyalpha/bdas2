@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Zapomenuté heslo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-light shadow-lg">
                <div class="card-header text-center">
                    <h2><i class="bi bi-key"></i> @ViewData["Title"]</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Zadejte svùj email a nové heslo pro reset pøístupu.
                    </p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <strong><i class="bi bi-exclamation-triangle"></i> Chyba:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="User" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-secondary text-light border-secondary", placeholder = "vas@email.cz", type = "email" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <hr class="my-4 border-secondary">

                        <div class="mb-3">
                            @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary">
                                    <i class="bi bi-key-fill"></i>
                                </span>
                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control bg-secondary text-light border-secondary", placeholder = "Zadejte nové heslo" })
                            </div>
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                            <div class="form-text text-muted small mt-2">
                                <i class="bi bi-info-circle"></i> 
                                Heslo musí obsahovat minimálnì 6 znakù - z toho minimálnì: jednu èíslici, jeden speciální znak, jedno malé a jedno velké písmeno.
                            </div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary">
                                    <i class="bi bi-check2-circle"></i>
                                </span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control bg-secondary text-light border-secondary", placeholder = "Potvrïte nové heslo" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Resetovat heslo
                            </button>
                            <a asp-action="Login" asp-controller="User" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Zpìt na pøihlášení
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}