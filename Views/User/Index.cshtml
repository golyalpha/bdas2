@model IEnumerable<WebApp.Models.Organiser>

@{
    ViewData["Title"] = "Uživatelé";
    var isAdmin = User.IsInRole("Administrator");
    var isGuest = ViewBag.IsGuest ?? false;
    var allUsers = ViewBag.AllUsers as List<WebApp.Models.Organiser> ?? Model.ToList();
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" id="searchString" name="searchString" 
                           value="@ViewData["CurrentFilter"]" 
                           class="form-control" 
                           placeholder="Hledat podle jména..." />
                    <button type="submit" class="btn btn-primary">Hledat</button>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <button type="button" class="btn btn-secondary" onclick="clearFilter()">Vymazat</button>
                    }
                </div>
            </div>
        </div>
    </form>

    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Jméno</th>
                @* Guest nemá vidět emaily *@
                @if (!isGuest)
                {
                    <th>Email</th>
                }
                <th>Role</th>
                <th>Náhradník</th>
                @if (isAdmin)
                {
                    <th class="text-center">Akce</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var organiser in Model)
            {
                <tr>
                    <td>
                        @if (isAdmin)
                        {
                            <a href="/User/Details/@organiser.Id" class="text-light">
                                @organiser.Name
                            </a>
                        }
                        else
                        {
                            @organiser.Name
                        }
                    </td>
                    @* Guest nemá vidět emaily *@
                    @if (!isGuest)
                    {
                        <td>@organiser.Email</td>
                    }
                    <td>
                        @if (organiser.Role.Name == "Administrator")
                        {
                            <span class="badge bg-danger">Administrator</span>
                        }
                        else if (organiser.Role.Name == "User")
                        {
                            <span class="badge bg-primary">User</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Guest</span>
                        }
                    </td>
                    <td>
                        @if (organiser.Substitute != null)
                        {
                            <span class="badge bg-info">@organiser.Substitute.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">Není nastaven</span>
                        }
                    </td>
                    @if (isAdmin)
                    {
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a href="/User/EditRole/@organiser.Id" class="btn btn-warning" title="Změnit roli">
                                    Role
                                </a>
                                <a href="/User/EditSubstitute/@organiser.Id" class="btn btn-info" title="Změnit náhradníka">
                                    Náhradník
                                </a>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function clearFilter() {
            const searchInput = document.getElementById('searchString');
            searchInput.value = '';
            searchInput.form.submit();
        }
    </script>
}
