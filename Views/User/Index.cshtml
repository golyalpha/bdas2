@model IEnumerable<WebApp.Models.Organiser>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var organiser in Model)
            {
                <tr>
                    <td>@organiser.Id</td>
                    <td>@organiser.Name</td>
                    <td>@organiser.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>
