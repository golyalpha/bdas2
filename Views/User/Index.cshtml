@model IEnumerable<WebApp.Models.Organiser>

@{
    ViewData["Title"] = "User List";
    var isAdmin = User.IsInRole("Administrator");
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> @ViewData["Title"]</h2>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-secondary text-light">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchString" name="searchString" 
                           value="@ViewData["CurrentFilter"]" 
                           class="form-control" 
                           placeholder="Hledat podle jm�na..." />
                    <button type="submit" class="btn btn-primary">Hledat</button>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <button type="button" class="btn btn-secondary" onclick="clearFilter()">Vymazat</button>
                    }
                </div>
            </div>
        </div>
    </form>

    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th><i class="bi bi-person"></i> Jméno</th>
                <th><i class="bi bi-envelope"></i> Email</th>
                <th><i class="bi bi-shield"></i> Role</th>
                @if (isAdmin)
                {
                    <th class="text-center"><i class="bi bi-gear"></i> Akce</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var organiser in Model)
            {
                <tr>
                    <td>
                        <a href="/User/Details/@organiser.Id" class="text-light">
                            @organiser.Name
                        </a>
                    </td>
                    <td>@organiser.Email</td>
                    <td>
                        @if (organiser.Role.Name == "Administrator")
                        {
                            <span class="badge bg-danger"><i class="bi bi-shield-fill-check"></i> Administrator</span>
                        }
                        else if (organiser.Role.Name == "User")
                        {
                            <span class="badge bg-primary"><i class="bi bi-person-check"></i> User</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-person"></i> Guest</span>
                        }
                    </td>
                    @if (isAdmin)
                    {
                        <td class="text-center">
                            @if (organiser.Role.Name != "Administrator")
                            {
                                <a href="/User/EditRole?id=@organiser.Id" class="btn btn-warning btn-sm" title="Změnit roli">
                                    <i class="bi bi-shield-fill-check"></i> Změnit roli
                                </a>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-lock"></i> Admin</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function clearFilter() {
            const searchInput = document.getElementById('searchString');
            searchInput.value = '';
            searchInput.form.submit();
        }
    </script>
}
